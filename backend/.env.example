# ==============================================================================
# AbleNova Backend Environment Configuration Template
# Copy this file to .env and supply your local or production credentials.
# NEVER commit actual secrets, keys, or .env files to Git.
# ==============================================================================

# Database Connection (Supabase PostgreSQL / pgvector)
# Option A: Supabase Connection Pooler (Port 6543 / 5432 - Recommended for serverless/microservices)
# Format: postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Supabase Direct Connection (Port 5432)
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Local development fallback:
# DATABASE_URL=sqlite:///./test.db
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false
DB_SSL_REQUIRE=true

# Supabase Platform Credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External AI Integrations
GEMINI_API_KEY=your_gemini_api_key

# Security & Authentication
JWT_SECRET=your-secure-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
